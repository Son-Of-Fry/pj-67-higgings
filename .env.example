# Configuración del Servidor
HOST=0.0.0.0
PORT=8000
APP_NAME=Higgings — AI-Native Agile & MCP Platform
APP_ENV=production

# Base de Datos (Persistencia SQLite)
DATABASE_URL=sqlite:////data/kanban.db

# Seguridad / Autenticación para clientes MCP y API (Opcional)
API_AUTH_TOKEN=change_this_to_a_secure_token

# Configuración de CORS
ALLOWED_ORIGINS=*
